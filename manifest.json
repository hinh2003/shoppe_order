{
    "manifest_version": 3,
    "name": "Shopee Order",
    "version": "1.0.0",
    "description": "Thống kê đơn hàng Shopee năm 2025",
    "permissions": [
        "cookies",
        "storage",
        "scripting",
        "activeTab"
    ],
    "host_permissions": [
        "https://shopee.vn/*"
    ],
    "icons": {
        "16": "images/icon16.png",
        "48": "images/icon48.png",
        "128": "images/icon128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "images/icon16.png",
            "48": "images/icon48.png",
            "128": "images/icon128.png"
        }
    }
}