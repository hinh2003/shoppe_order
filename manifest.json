{
  "manifest_version": 3,
  "name": "Thống Kê Shopee",
  "version": "2.0",
  "description": "Xem thống kê chi tiêu trên Shopee theo năm",
  "permissions": [
    "cookies",
    "scripting",
    "activeTab",
    "storage",
    "notifications",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.shopee.vn/*"
  ],
  "action": {
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}